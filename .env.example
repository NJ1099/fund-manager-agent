# 이 파일을 복사해 .env 로 저장하고 실제 값을 채우세요.
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# Kronos 레포 경로.
# 프로젝트 루트에 `git clone …/Kronos.git` 했다면 설정할 필요가 없습니다 (기본값).
# 다른 위치에 클론했을 때만 주석을 풀고 경로를 지정하세요.
# KRONOS_REPO=/path/to/Kronos

# PM 논평을 LLM으로 올리려면 설정 (비워두면 결정론적 룰 기반으로 자동 폴백)
ANTHROPIC_API_KEY=
PM_MODEL=claude-sonnet-4-6

# Kronos 추론 디바이스 (cpu 또는 cuda)
KRONOS_DEVICE=cpu

# loop 모드에서만 사용 (초 단위, 테스트용)
CYCLE_INTERVAL_SEC=0
