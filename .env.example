# 이 파일을 복사해 .env 로 저장하고 실제 값을 채우세요.
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# Kronos 레포 경로 (README 설치 단계에서 클론한 위치)
KRONOS_REPO=E:/AI/fund_manager_agent/Kronos

# PM 논평을 LLM으로 올리려면 설정 (비워두면 결정론적 룰 기반으로 자동 폴백)
ANTHROPIC_API_KEY=
PM_MODEL=claude-sonnet-4-6

# Kronos 추론 디바이스 (cpu 또는 cuda)
KRONOS_DEVICE=cpu

# loop 모드에서만 사용 (초 단위, 테스트용)
CYCLE_INTERVAL_SEC=0

# ---------------------------------------------------------------- 보유 종목 (선택)
# 실제 계좌의 보유 종목을 가져오려면 아래를 채우세요. **조회 전용**입니다 —
# 이 프로그램에는 주문 API 가 존재하지 않습니다.
# 키는 이 파일(.env)에만 두세요. 채팅·코드·커밋에 넣지 마세요.

# 평가액을 합산할 기준 통화 (KRW 또는 USD)
HOLDINGS_BASE_CURRENCY=KRW

# 토스증권 Open API — https://developers.tossinvest.com 에서 신청
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 한국투자증권 Open API — https://apiportal.koreainvestment.com 에서 신청
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
